{
  "name": "moj-ai-workspace",
  "image": "mcr.microsoft.com/vscode/devcontainers/universal:latest",
  "remoteUser": "codespace",
  "postCreateCommand": "bash ${containerWorkspaceFolder}/.devcontainer/start-opencode-web.sh --install-only || true",
  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/start-opencode-web.sh || true",
  "forwardPorts": [4096],
  "portsAttributes": {
    "4096": {
      "label": "opencode web",
      "onAutoForward": "notify"
    }
  }
}
